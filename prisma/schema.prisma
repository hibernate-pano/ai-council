generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  councils  Council[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Council {
  id        String   @id @default(cuid())
  question  String
  status    String   @default("pending") // pending, in_progress, completed, failed
  rounds    Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants CouncilParticipant[]
  messages   Message[]
  consensus  ConsensusPoint[]

  @@index([userId])
  @@index([status])
}

model CouncilParticipant {
  id         String @id @default(cuid())
  councilId  String
  modelName  String // openai/gpt-4o, anthropic/claude-opus-4-7, etc.
  role       String // moderator, participant
  systemPrompt String
  displayName String

  council  Council   @relation(fields: [councilId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([councilId])
}

model Message {
  id            String   @id @default(cuid())
  councilId     String
  participantId String
  content       String
  round         Int      @default(1)
  type          String   @default("response") // opening, critique, consensus, conclusion, system
  createdAt     DateTime @default(now())

  council     Council            @relation(fields: [councilId], references: [id], onDelete: Cascade)
  participant CouncilParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([councilId, round])
  @@index([participantId])
}

model ConsensusPoint {
  id         String   @id @default(cuid())
  councilId  String
  content    String
  agreement  Float    @default(0.0) // 0-100
  round      Int      @default(1)
  createdAt  DateTime @default(now())

  council Council @relation(fields: [councilId], references: [id], onDelete: Cascade)

  @@index([councilId])
}
